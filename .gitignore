# Datasets don't go in here - see the PLACE_..._DATA_HERE.md in each Data folder.
# Ignore everything in them except that file.
data_preparation/kaggle/Data/*
!data_preparation/kaggle/Data/PLACE_KAGGLE_DATA_HERE.md
data_preparation/OASIS-1/Data/*
!data_preparation/OASIS-1/Data/PLACE_OASIS-1_DATA_HERE.md

# Scans pulled out of the OASIS tars (~3GB). Regenerate by running the notebook.
data_preparation/OASIS-1/extracted_scans/

# The OASIS slice images. Can't go in a public repo under the data agreement.
# The csv and the json are fine, they're metadata.
data_preparation/OASIS-1/prepped_data_oasis/slices.npz

# Raw scan formats, just in case
*.tar
*.tar.gz
*.img
*.hdr
*.nii
*.nii.gz

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# Excel lock files
~$*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

